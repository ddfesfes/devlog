---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header>
  <a class="logo" href={base}>archive.</a>
  <nav>
    <a href={base}>Home</a>
    <a href={`${base}projects`}>Projects</a>
    <a href={`${base}blog`}>Blog</a>
    <a href={`${base}about`}>About</a>
  </nav>
</header>

<style>
  header {
    max-width: 960px;
    height: 76px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .logo {
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -1px;
  }

  nav {
    display: flex;
    gap: 28px;
    font-size: 13px;
    color: #777;
  }

  nav a:hover {
    color: #111;
  }

  @media (max-width: 600px) {
    header {
      padding-left: 20px;
      padding-right: 20px;
    }

    nav {
      gap: 14px;
      font-size: 11px;
    }
  }
</style>