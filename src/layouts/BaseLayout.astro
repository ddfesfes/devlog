---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Archive — Personal Portfolio",
  description = "Personal portfolio and development blog.",
} = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fafafa;
    color: #222;
    font-family: Arial, "Noto Sans KR", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  @media (max-width: 600px) {
    main {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>