---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as {
  post: CollectionEntry<"blog">;
};

const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Archive`}
  description={post.data.description}
>
  <a class="back" href={`${base}blog`}>← Back to Blog</a>

  <article>
    <div class="meta">
      <time>{post.data.pubDate.toLocaleDateString("ko-KR")}</time>
      <span>{post.data.category}</span>
    </div>

    <h1>{post.data.title}</h1>
    <p class="description">{post.data.description}</p>

    <hr />

    <div class="markdown">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-top: 48px;
    font-size: 12px;
    color: #888;
  }

  .back:hover {
    color: #222;
  }

  article {
    max-width: 720px;
    margin: 55px auto 120px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    color: #999;
    font-size: 12px;
  }

  h1 {
    font-size: 42px;
    line-height: 1.3;
    letter-spacing: -1.5px;
    margin: 22px 0 12px;
    overflow-wrap: break-word;
  }

  .description {
    color: #888;
    font-size: 15px;
    line-height: 1.7;
  }

  hr {
    border: 0;
    border-top: 1px solid #eee;
    margin: 40px 0;
  }

  .markdown {
    font-size: 15px;
    line-height: 1.9;
    color: #444;
    overflow-wrap: break-word;
  }

  .markdown :global(h2),
  .markdown :global(h3) {
    color: #222;
    margin-top: 40px;
    letter-spacing: -0.5px;
  }

  .markdown :global(h2) {
    font-size: 24px;
  }

  .markdown :global(h3) {
    font-size: 19px;
  }

  .markdown :global(p) {
    margin: 18px 0;
  }

  .markdown :global(ul),
  .markdown :global(ol) {
    padding-left: 24px;
  }

  .markdown :global(pre) {
    background: #eee;
    padding: 18px;
    border-radius: 5px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.7;
  }

  .markdown :global(code) {
    font-family: Consolas, monospace;
  }

  .markdown :global(:not(pre) > code) {
    background: #eee;
    padding: 2px 5px;
    border-radius: 3px;
  }

  .markdown :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 28px auto;
    border-radius: 5px;
  }

  .markdown :global(blockquote) {
    margin: 24px 0;
    padding: 4px 18px;
    border-left: 3px solid #ddd;
    color: #777;
  }

  .markdown :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    article {
      margin-top: 40px;
      margin-bottom: 80px;
    }

    h1 {
      font-size: 32px;
    }

    .markdown {
      font-size: 14px;
    }
  }
</style>
