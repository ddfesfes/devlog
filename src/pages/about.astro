---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — Archive">
      <section class="intro">
        <span>ABOUT ME</span>
        <h1>About</h1>
        <p>저에 대한 소개와 관심 분야를 정리한 페이지입니다.</p>
      </section>

      <section class="profile">
        <div class="profile-image">PROFILE</div>
        <div>
          <span class="label">INTRODUCTION</span>
          <h2>Hello, nice to meet you.</h2>
          <p>
            안녕하세요. 새로운 것을 배우고 직접 만들어 보는 것을 좋아합니다.
            개발 과정에서 얻은 경험과 지식을 기록하고 공유합니다.
          </p>
        </div>
      </section>

      <section class="info">
        <div>
          <h2>Interests</h2>
          <div class="tags">
            <span>Web Development</span>
            <span>Programming</span>
            <span>Technology</span>
            <span>Learning</span>
          </div>
        </div>

        <div>
          <h2>Links</h2>
          <a href="https://github.com/" target="_blank">GitHub ↗</a>
          <a href="mailto:your@email.com">Email ↗</a>
        </div>
      </section>
</BaseLayout>

<style>
  .logo { font-size: 21px; font-weight: 750; }

  .intro { padding: 85px 0 55px; }

  .intro > span, .label {
    color: #999;
    font-size: 11px;
    letter-spacing: 1px;
  }

  h1 { font-size: 48px; letter-spacing: -2px; margin: 15px 0; }

  .intro > p { color: #888; font-size: 14px; }

  .profile {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 50px;
    align-items: center;
    padding: 25px 0 65px;
    border-bottom: 1px solid #eee;
  }

  .profile-image {
    height: 260px;
    background: #eeefef;
    display: grid;
    place-items: center;
    color: #aaa;
    font-size: 12px;
  }

  h2 { font-size: 19px; }

  .profile p {
    font-size: 14px;
    color: #888;
    line-height: 1.9;
  }

  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    padding: 40px 0 100px;
  }

  .tags { display: flex; flex-wrap: wrap; gap: 8px; }

  .tags span {
    padding: 8px 12px;
    background: #eee;
    border-radius: 3px;
    font-size: 12px;
  }

  .info > div:last-child a {
    display: block;
    font-size: 13px;
    color: #777;
    margin: 12px 0;
  }

  @media (max-width: 600px) {
    .profile { grid-template-columns: 1fr; gap: 25px; }
    .profile-image { height: 220px; }
    .info { grid-template-columns: 1fr; gap: 25px; }
  }
</style>
