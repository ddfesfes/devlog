---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout
  title={`${project.data.name} — Archive`}
  description={project.data.description}
>
  <a class="back-link" href={`${base}projects`}>← Projects</a>

  <section class="project-detail">
    <span class="number">{project.data.number} / PROJECT</span>

    {project.data.image && (
      <img
        class="project-image"
        src={`${base}${project.data.image.replace(/^\/+/, "")}`}
        alt={`${project.data.name} preview`}
      />
    )}

    <h1>{project.data.name}</h1>
    <p class="category">{project.data.category}</p>
    <p class="description">{project.data.description}</p>

    <div class="content">
      <Content />
    </div>

    <div class="tech-section">
      <h2>Tech Stack</h2>
      <div class="tech-list">
        {project.data.tech.map((item) => <span>{item}</span>)}
      </div>
    </div>

    {project.data.link !== "#" && (
      <a
        class="project-link"
        href={project.data.link}
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Project ↗
      </a>
    )}
  </section>
</BaseLayout>

<style>
  .back-link { display: inline-block; margin-top: 48px; color: #888; font-size: 13px; }
  .back-link:hover { color: #222; }
  .project-detail { padding: 80px 0 120px; max-width: 680px; }
  .number { color: #999; font-size: 12px; letter-spacing: 1px; }
  .project-image { display: block; width: 100%; aspect-ratio: 16 / 9; margin-top: 32px; border-radius: 6px; border: 1px solid #eee; object-fit: cover; }
  h1 { margin: 32px 0 8px; font-size: 42px; letter-spacing: -1.5px; }
  .category { color: #888; font-size: 13px; }
  .description { margin-top: 40px; line-height: 1.8; color: #555; }
  .content { margin-top: 48px; color: #666; font-size: 14px; line-height: 1.9; }
  .content h2 { margin-top: 40px; margin-bottom: 12px; color: #222; font-size: 18px; }
  .content p { margin: 18px 0; }
  .content ul, .content ol { padding-left: 24px; }
  .content pre { background: #eee; padding: 18px; border-radius: 5px; overflow-x: auto; }
  .content code { font-family: Consolas, monospace; }
  .content :not(pre) > code { background: #eee; padding: 2px 5px; border-radius: 3px; }
  .content img { display: block; max-width: 100%; height: auto; margin: 28px auto; border-radius: 5px; }
  .content blockquote { margin: 24px 0; padding: 4px 18px; border-left: 3px solid #ddd; color: #777; }
  .tech-section { margin-top: 56px; }
  .tech-section h2 { font-size: 16px; margin-bottom: 18px; }
  .tech-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .tech-list span { padding: 7px 12px; border: 1px solid #e5e5e5; border-radius: 4px; color: #666; font-size: 12px; }
  .project-link { display: inline-block; margin-top: 48px; font-size: 13px; border-bottom: 1px solid #222; padding-bottom: 4px; }
  @media (max-width: 600px) {
    .project-detail { padding-top: 60px; }
    h1 { font-size: 32px; }
  }
</style>
