---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title="Projects — Archive">
  <section class="intro">
    <span>PORTFOLIO</span>
    <h1>Projects</h1>
    <p>지금까지 만들고 경험한 프로젝트를 정리합니다.</p>
  </section>

  <section class="project-list">
    {projects.map((project) => (
      <article class="project">
        <a class="project-image" href={`${base}projects/${project.id}`}>
          {project.data.image ? (
            <img
              src={`${base}${project.data.image.replace(/^\/+/, "")}`}
              alt={`${project.data.name} preview`}
            />
          ) : (
            <span>{project.data.number}</span>
          )}
        </a>

        <div class="project-info">
          <span class="category">{project.data.category}</span>
          <h2>
            <a href={`${base}projects/${project.id}`}>
              {project.data.name}
            </a>
          </h2>
          <p>{project.data.description}</p>

          <div class="tags">
            {project.data.tech.map((tech) => <span>{tech}</span>)}
          </div>

          {project.data.link !== "#" && (
            <a
              class="external-link"
              href={project.data.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              View Project ↗
            </a>
          )}
        </div>
      </article>
    ))}

    {projects.length === 0 && (
      <p class="empty">아직 등록된 프로젝트가 없습니다.</p>
    )}
  </section>
</BaseLayout>

<style>
  .intro { padding: 85px 0 55px; }
  .intro > span, .category { color: #999; font-size: 11px; letter-spacing: 1px; }
  h1 { font-size: 48px; letter-spacing: -2px; margin: 15px 0; }
  .intro p { color: #888; font-size: 14px; }
  .project-list { padding-bottom: 90px; }
  .project { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; padding: 30px 0; border-bottom: 1px solid #eee; }
  .project-image { aspect-ratio: 16 / 9; background: #eeefef; display: grid; place-items: center; color: #aaa; overflow: hidden; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .project-info { align-self: center; }
  h2 { font-size: 22px; margin: 12px 0; }
  .project-info p { color: #888; font-size: 13px; line-height: 1.8; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0; }
  .tags span { padding: 6px 10px; background: #eee; border-radius: 3px; font-size: 11px; }
  .external-link { font-size: 12px; }
  .empty { color: #999; font-size: 14px; }
  @media (max-width: 600px) {
    .project { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
