---
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects — Archive">
  <section class="intro">
    <span>PORTFOLIO</span>
    <h1>Projects</h1>
    <p>지금까지 만들고 경험한 프로젝트를 정리합니다.</p>
  </section>

  <section class="project-list">
    {projects.map((project) => (
      <article class="project">
        <a class="project-image" href={`/projects/${project.slug}`}>
          {project.image ? (
            <img src={project.image} alt={`${project.name} preview`} />
          ) : (
            <span>{project.number}</span>
          )}
        </a>

        <div class="project-info">
          <span class="category">{project.category}</span>

          <h2>
            <a href={`/projects/${project.slug}`}>{project.name}</a>
          </h2>

          <p>{project.description}</p>

          <div class="tags">
            {project.tech.map((tech) => <span>{tech}</span>)}
          </div>

          {project.link !== "#" && (
            <a
              class="external-link"
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              View Project ↗
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 85px 0 55px;
  }

  .intro > span,
  .category {
    color: #999;
    font-size: 11px;
    letter-spacing: 1px;
  }

  h1 {
    font-size: 48px;
    letter-spacing: -2px;
    margin: 15px 0;
  }

  .intro p {
    color: #888;
    font-size: 14px;
  }

  .project-list {
    padding-bottom: 90px;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    padding: 30px 0;
    border-bottom: 1px solid #eee;
  }

  .project-image {
    aspect-ratio: 16 / 9;
    background: #eeefef;
    display: grid;
    place-items: center;
    color: #aaa;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    align-self: center;
  }

  h2 {
    font-size: 22px;
    margin: 12px 0;
  }

  .project-info p {
    color: #888;
    font-size: 13px;
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }

  .tags span {
    padding: 6px 10px;
    background: #eee;
    border-radius: 3px;
    font-size: 11px;
  }

  .external-link {
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .project {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .project-image {
      aspect-ratio: 16 / 9;
    }
  }
</style>
