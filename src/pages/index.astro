---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const posts = await getCollection("blog");
const base = import.meta.env.BASE_URL;

posts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="Archive — Personal Portfolio"
  description="Personal portfolio and development blog."
>
  <section class="hero">
    <span class="eyebrow">PERSONAL WEBSITE</span>
    <h1>Hello, I'm a developer.</h1>
    <p class="subtitle">Learning, building and documenting.</p>
    <p class="intro">개발하고, 공부하고, 경험한 것들을 기록합니다.</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Selected Projects</h2>
      <a href={`${base}projects`}>View all ↗</a>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project">
          <a class="project-image" href={`${base}projects/${project.id}`}>
            {project.data.image ? (
              <img
                src={`${base}${project.data.image.replace(/^\/+/, "")}`}
                alt={`${project.data.name} preview`}
              />
            ) : (
              <span>{project.data.number}</span>
            )}
          </a>

          <span class="category">{project.data.category}</span>

          <h3>
            <a href={`${base}projects/${project.id}`}>
              {project.data.name}
            </a>
          </h3>

          <p>{project.data.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section posts">
    <div class="section-heading">
      <h2>Latest Posts</h2>
      <a href={`${base}blog`}>View all ↗</a>
    </div>

    {latestPosts.map((post: CollectionEntry<"blog">) => (
      <article class="post">
        <time>{post.data.pubDate.toLocaleDateString("ko-KR")}</time>

        <h3>
          <a href={`${base}blog/${post.id}`}>{post.data.title}</a>
        </h3>

        <span class="category">{post.data.category}</span>
      </article>
    ))}

    {latestPosts.length === 0 && (
      <p class="empty">아직 작성된 글이 없습니다.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 112px 0 100px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    color: #888;
  }

  h1 {
    margin: 24px 0 10px;
    font-size: clamp(38px, 7vw, 62px);
    letter-spacing: -3px;
    line-height: 1.15;
  }

  .subtitle {
    font-size: 21px;
    color: #888;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .intro {
    margin-top: 28px;
    font-size: 14px;
    color: #777;
  }

  .section {
    padding: 40px 0 75px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    font-size: 19px;
    letter-spacing: -0.5px;
  }

  .section-heading a {
    font-size: 12px;
    color: #888;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-image {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: #eeefef;
    color: #aaa;
    font-size: 13px;
    margin-bottom: 18px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .category {
    color: #999;
    font-size: 11px;
  }

  .project h3 {
    font-size: 17px;
    margin: 8px 0;
  }

  .project p {
    color: #888;
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
  }

  .post {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: center;
    gap: 15px;
    padding: 20px 0;
    border-bottom: 1px solid #eee;
  }

  .post time {
    font-size: 12px;
    color: #999;
  }

  .post h3 {
    font-size: 14px;
    font-weight: 500;
  }

  .post h3 a:hover,
  .project h3 a:hover {
    color: #888;
  }

  .empty {
    padding: 20px 0;
    color: #999;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 85px 0 75px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .post {
      grid-template-columns: 1fr auto;
      gap: 4px 10px;
    }

    .post h3 {
      grid-column: 1;
      grid-row: 2;
      margin: 5px 0;
    }

    .post .category {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
